<Window x:Class="Deployer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OptiScaler 部署工具" Width="1320" Height="860" MinWidth="1020" MinHeight="650" WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <Grid Margin="16" Background="{StaticResource CanvasBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" CornerRadius="9" Padding="14" Margin="0,0,0,12" BorderBrush="#DCE4ED" BorderThickness="1">
   <DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock Text="OptiScaler 部署工具" FontSize="20" FontWeight="Bold"/><TextBlock Text="先检查文件变更与备份，再执行部署。扫描与写入只在你主动操作时运行。" Foreground="#617184" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="打开历史 / 恢复" Click="OpenHistory_Click" ToolTip="浏览已保存的部署清单并回滚"/></DockPanel>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="230"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="540"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" CornerRadius="9" BorderBrush="#DCE4ED" BorderThickness="1" Padding="10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="游戏库" FontSize="17" FontWeight="SemiBold" Margin="4,2,0,8"/>
     <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Grid.ColumnSpan="2" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索游戏名称或安装目录"/><ComboBox Grid.Row="1" Width="92" ItemsSource="{Binding PlatformFilters}" SelectedItem="{Binding PlatformFilter}" ToolTip="筛选平台"/><Button Grid.Row="1" Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}"/></Grid>
     <ListBox Grid.Row="2" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><Border Padding="8" Margin="0,2" Background="#F6F8FB" CornerRadius="5"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Platform}" Foreground="#617184"/><TextBlock Text="{Binding InstallRoot}" FontSize="11" Foreground="#617184" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallRoot}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <WrapPanel Grid.Row="3" Margin="-3,8,-3,-3"><Button Content="添加本地目录" Click="AddFolder_Click"/><Button Content="移除手动目录" Command="{Binding RemoveManualFolderCommand}"/></WrapPanel>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="False"/>
   <ScrollViewer x:Name="PlanScrollViewer" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinWidth="540">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="White" CornerRadius="9" BorderBrush="#DCE4ED" BorderThickness="1" Padding="12" Margin="0,0,0,8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="目标与程序" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedGame.InstallRoot, TargetNullValue=请选择游戏}" Foreground="#617184" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="平台 / 可写性" Foreground="#617184"/><TextBlock><Run Text="{Binding SelectedGame.Platform, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SelectedGame.Writability, Mode=OneWay}"/></TextBlock></StackPanel>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"><TextBlock Text="游戏 EXE 候选" Foreground="#617184"/><ComboBox ItemsSource="{Binding SelectedGame.ExecutableCandidates}" SelectedItem="{Binding SelectedExecutable, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Payload 目录（留空优先本地构建，再获取官方发布）" Foreground="#617184"/><TextBox Grid.Row="1" Text="{Binding PayloadDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="手动选择的 Payload 目录；留空优先本地构建，缺失时获取官方 stable 发布"/><Button Grid.Row="1" Grid.Column="1" Content="浏览…" Click="BrowsePayload_Click"/><TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="实际 Payload：" Foreground="#617184"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PlanPayloadText}"/></Grid><WrapPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="4,5,0,0"><TextBlock Text="计划摘要：" FontWeight="SemiBold" Foreground="#617184"/><TextBlock Text="目录：" Foreground="#617184"/><TextBlock Text="{Binding CurrentPlan.Payload.RootDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentPlan.Payload.RootDirectory}"/><TextBlock Text="  ·  身份：" Foreground="#617184"/><TextBlock Text="{Binding CurrentPlan.Identity.FileName}"/><TextBlock Text="  ·  部署目录：" Foreground="#617184"/><TextBlock Text="{Binding PlanDestination}"/><TextBlock Text="  ·  计划：" Foreground="#617184"/><TextBlock Text="{Binding CurrentPlan.PlanId}"/><TextBlock Text="  ·  文件 / 备份 / INI：" Foreground="#617184"/><TextBlock><Run Text="{Binding WriteCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding BackupCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding IniEditCount, Mode=OneWay}"/></TextBlock></WrapPanel>
     </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
     <GroupBox Header="配置方案"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName"/><WrapPanel Grid.Column="1"><Button Content="编辑" Click="EditProfile_Click"/><Button Content="克隆" Command="{Binding CloneProfileCommand}"/><Button Content="删除用户档" Click="DeleteProfile_Click"/></WrapPanel><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SelectedProfile.Description}" Foreground="#617184" Margin="6,4,0,0"/><TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="AMD 性能预设：DX11 FSR 3.1、Vulkan FSR 2.2；DX12 FFX API（ffx_12.dll）有额外互操作成本。" Foreground="#2463A8" Margin="6,4,0,0"/></Grid></GroupBox>
     <GroupBox Grid.Column="1" Header="可选功能"><StackPanel><CheckBox Content="启用 Frame Generation（默认关闭）" IsChecked="{Binding EnableFrameGen}"/><TextBlock Text="仅在体检确认兼容后启用；默认不更改此项。" Foreground="#617184" Margin="5,2,5,5"/></StackPanel></GroupBox>
    </Grid>
    <Border Grid.Row="2" Background="#EAF2FB" CornerRadius="7" Padding="9" Margin="0,0,0,7"><StackPanel><DockPanel><TextBlock Text="体检结果" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock Text="{Binding GraphicsApisText, TargetNullValue=等待扫描}"/><TextBlock Text="  ·  SDK："/><TextBlock Text="{Binding DetectedSdksText}"/><TextBlock Text="  ·  写入："/><TextBlock Text="{Binding CurrentInspection.Writability}"/></DockPanel><ItemsControl ItemsSource="{Binding ServiceWarnings}" Margin="0,5,0,0" MaxHeight="58"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#9A3412"/></DataTemplate></ItemsControl.ItemTemplate><ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template></ItemsControl></StackPanel></Border>
    <TabControl Grid.Row="3" Background="White" Height="260" MinHeight="220">
     <TabItem Header="文件变更"><DataGrid ItemsSource="{Binding CurrentPlan.Writes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="源文件" Binding="{Binding SourcePath}" Width="*" MinWidth="200"/><DataGridTextColumn Header="目标路径" Binding="{Binding DestinationPath}" Width="1.4*" MinWidth="260"/><DataGridTextColumn Header="大小" Binding="{Binding Length}" Width="90"/><DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="180"/></DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="备份"><DataGrid ItemsSource="{Binding CurrentPlan.Backups}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="原文件" Binding="{Binding OriginalPath}" Width="*" MinWidth="240"/><DataGridTextColumn Header="备份文件" Binding="{Binding BackupPath}" Width="1.5*" MinWidth="300"/><DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="150"/></DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="INI 对比"><DataGrid ItemsSource="{Binding CurrentPlan.IniEdits}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="140" MinWidth="130"/><DataGridTextColumn Header="键" Binding="{Binding Key}" Width="180" MinWidth="150"/><DataGridTextColumn Header="原值" Binding="{Binding OldValue}" Width="*" MinWidth="180"/><DataGridTextColumn Header="新值" Binding="{Binding NewValue}" Width="*" MinWidth="180"/></DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="警告 / 阻塞"><DataGrid ItemsSource="{Binding PlanWarnings}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="级别" Binding="{Binding Severity}" Width="120"/><DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" MinWidth="260"/></DataGrid.Columns></DataGrid></TabItem>
    </TabControl>
    <Border Grid.Row="4" Background="White" BorderBrush="#DCE4ED" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,8,0,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="{Binding CurrentPlan.Identity.UserPromptMessage}" Foreground="#9A3412" FontWeight="SemiBold"/><TextBlock Text="覆盖现存 DLL 时会先创建备份；ASI 身份要求另行安装 ASI Loader（本工具不会下载或安装）。更改身份后请重新生成并检查计划。" Foreground="#617184"/></StackPanel>
      <WrapPanel Grid.Column="1"><Button Content="允许覆盖并重建" Click="AllowOverwrite_Click"/><Button Content="改用 ASI 并重建" Click="PreferAsi_Click"/><Button Content="取消此计划" Click="CancelIdentity_Click"/></WrapPanel>
      <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="我已检查上方全部目标路径、备份、INI 变更和警告，并确认按此计划部署。" IsChecked="{Binding PlanReviewAcknowledged}" Margin="4,8"/>
      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="需要管理员权限时，仅部署步骤会请求授权；取消授权不会部署。未知权限、阻塞项和身份冲突需先处理。" Foreground="#617184" FontSize="11"/>
     </Grid>
    </Border>
    <GroupBox Grid.Row="5" Header="部署后健康检查" Margin="0,8,0,0">
     <StackPanel>
      <TextBlock Text="{Binding HealthTargetText}" TextTrimming="CharacterEllipsis"/>
      <TextBox Text="{Binding RecoveryManifest, Mode=OneWay}" IsReadOnly="True" ToolTip="本次部署或失败任务的恢复清单路径，可复制"/>
      <TextBlock Text="{Binding HealthMessage}" TextWrapping="Wrap" Foreground="#617184" Margin="4"/>
      <TextBlock Text="FSR 3.X 仅表示日志中的后端族与注入信号；GPU、驱动和具体模型兼容性仍需人工确认。" TextWrapping="Wrap" Foreground="#9A3412" Margin="4,0,4,4"/>
      <WrapPanel><TextBlock Text="预期超分名称（按游戏实际图形 API 调整）" VerticalAlignment="Center"/><TextBox Width="160" Text="{Binding ExpectedBackend, UpdateSourceTrigger=PropertyChanged}"/></WrapPanel>
      <WrapPanel><Button Content="启动游戏并检查" Command="{Binding HealthCheckCommand}"/><Button Content="继续等待" Command="{Binding WaitHealthCommand}"/><Button Content="查看日志" Click="HealthLog_Click"/><Button Content="按本次清单恢复" Command="{Binding HealthRollbackCommand}"/><Button Content="关闭日志（生成新计划）" Click="DisableLogging_Click" IsEnabled="{Binding CanDisableLogging}" ToolTip="仅健康检查通过后可用；会生成新的完整计划并要求重新审核"/></WrapPanel>
     </StackPanel>
    </GroupBox>
   </Grid>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#DCE4ED" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,10,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel><Button Content="生成 / 更新计划" Command="{Binding GeneratePlanCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="保存计划 JSON" Click="SavePlan_Click"/><Button Content="查看安装历史" Click="OpenHistory_Click"/><Button Content="选择 manifest 并恢复" Click="RollbackManifest_Click" Style="{StaticResource DangerButton}"/></WrapPanel>
    <WrapPanel Grid.Column="1"><Button x:Name="CancelOperationButton" Content="取消当前操作" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"/><Button Content="执行部署" Command="{Binding ExecuteCommand}" Style="{StaticResource PrimaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ExecuteBlockReason}"/><Button Content="数据目录…" Click="StoragePaths_Click"/><Button Content="编辑配置" Click="EditProfile_Click"/></WrapPanel>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="4,4,4,0"><DockPanel><TextBlock Text="{Binding ProgressMessage}"/><ProgressBar IsIndeterminate="{Binding IsIndeterminate}" Height="8" Width="150" Margin="8,3"/><TextBlock Style="{StaticResource ErrorDetailText}" Text="{Binding ErrorMessage}" Foreground="#B42318" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding ExecuteBlockReason}" TextWrapping="Wrap" Foreground="#9A3412"/><TextBlock Style="{StaticResource ErrorDetailText}" Text="{Binding SuggestedAction}" Foreground="#9A3412"/><TextBox Style="{StaticResource ErrorDetailControl}" Text="{Binding DiagnosticDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="70" VerticalScrollBarVisibility="Auto" ToolTip="诊断详情；右侧按钮可复制"/><Button Style="{StaticResource ErrorDetailControl}" Content="复制错误详情" HorizontalAlignment="Right" Click="CopyError_Click"/></StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
















